# Copy to .env.local and fill in your Resend API key.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Optional — defaults to "Eveia.AI Website <noreply@eveia.ai>"
# Do NOT set this to onboarding@resend.dev on Vercel — it will fail in production.
# CONTACT_FROM=Eveia.AI Website <noreply@eveia.ai>
CONTACT_TO=
CONTACT_CC=

# Public frontend values (Vite)
VITE_CALENDLY_DEMO_URL=https://calendly.com/eveia
VITE_CONTACT_EMAIL=
VITE_CONTACT_MOBILE=
VITE_CONTACT_LANDLINE=
VITE_CONTACT_HR_ADMIN=

# Eveia.AI website chatbot (same agent + proxy as eveia-landing-main)
# Dev/prod proxy: /eveia-api → https://api.eveia.ai
# VITE_EVEIA_API_BASE=/eveia-api
VITE_EVEIA_AGENT_ID=7e5923e3-9b4f-43ab-b3e3-ab0764ea4487
VITE_EVEIA_API_KEY=
# VITE_INQUIRY_ENDPOINT=/eveia-api/api/v1/public/inquiries
